# Copy this file to `.env` (same folder) and paste your free OpenAlex key.
# Get one in ~30 seconds at https://openalex.org/settings/api
#
# The key is optional. Without it the CLI still works, on a $0.10/day budget
# instead of $1/day. Placeholder values are ignored, so an unedited copy of
# this file is harmless.
#
# Precedence: OPENALEX_API_KEY env var  >  ~/.openalex_key  >  this .env

OPENALEX_API_KEY=paste_your_key_here

# Optional: identifies your requests to OpenAlex. Not required.
# OPENALEX_MAILTO=szabogabor97@gmail.com
